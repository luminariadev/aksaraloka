# ====================================================================
# AksaraLoka — Environment Variables Template
# "Semesta Aksara & Arsip Pengetahuan Terbuka"
# ====================================================================

# --------------------------------------------
# 1. Aplikasi
# --------------------------------------------
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=aksaraloka-editorial-secret-2026

# --------------------------------------------
# 2. Database Engine (Dual-Engine: SQLite & PostgreSQL/Supabase)
# --------------------------------------------
# Opsi DB_ENGINE: 'sqlite' (default, offline lokal) atau 'postgres' (Supabase / Cloud)
DB_ENGINE=sqlite

# JIKA MENGGUNAKAN SUPABASE / POSTGRESQL:
# Cukup isi DATABASE_URL dengan Connection String dari Supabase (URI):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Atau gunakan konfigurasi host lokal (jika punya PostgreSQL di laptop):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mylibrary
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false